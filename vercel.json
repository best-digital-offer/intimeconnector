{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/mcp", "destination": "/api" },
    { "source": "/.well-known/:path*", "destination": "/api" },
    { "source": "/((?!api/|mcp$|\\.well-known/).*)", "destination": "/index.html" }
  ]
}
